# === APIs de IA ===
OPENAI_API_KEY=sk-...
PERPLEXITY_API_KEY=pplx-...

# === WordPress ===
# URL base de tu WordPress (sin barra al final)
WP_URL=https://tudominio.com
# Usuario administrador de WordPress
WP_USERNAME=admin
# Contraseña de aplicación (generar en WP Admin > Perfil > Contraseñas de aplicación)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# === WordPress SEO (opcional) ===
# Plugin SEO instalado: yoast | rankmath | aioseo
WP_SEO_PLUGIN=yoast

# === Categorías WordPress ===
# Nombre de la categoría para el artículo de mercados (se crea si no existe)
WP_CATEGORY_MARKETS=Análisis de Mercados
# Nombre de la categoría para el artículo de acciones USA
WP_CATEGORY_US=Acciones USA
